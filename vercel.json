{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "diaspora-immo.vercel.app" }
      ],
      "destination": "https://www.sokile.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/annonce/:id", "destination": "/index.html" },
    { "source": "/guide/:id", "destination": "/index.html" }
  ]
}
