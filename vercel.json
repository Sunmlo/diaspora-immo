{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "diaspora-immo.vercel.app"
        }
      ],
      "destination": "https://www.sokile.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/agence/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/validation/locadakar",
      "destination": "/validation/locadakar/index.html"
    },
    {
      "source": "/validation/locadakar/",
      "destination": "/validation/locadakar/index.html"
    },
    {
      "source": "/programmes-neufs",
      "destination": "/index.html"
    },
    {
      "source": "/programme/:id",
      "destination": "/index.html"
    },
    {
      "source": "/annonce/:id",
      "destination": "/index.html"
    },
    {
      "source": "/guide/:id",
      "destination": "/index.html"
    },
    {
      "source": "/verification-professionnels",
      "destination": "/index.html"
    },
    {
      "source": "/cadeau",
      "destination": "/index.html"
    },
    {
      "source": "/cadeau/",
      "destination": "/index.html"
    },
    {
      "source": "/recherche",
      "destination": "/index.html"
    },
    {
      "source": "/recherche/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/validation/locadakar/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
